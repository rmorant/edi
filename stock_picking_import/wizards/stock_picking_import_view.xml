<odoo>

    <!-- TODO: -->

    <record id="stock_picking_import_form" model="ir.ui.view">
        <field name="name">stock.picking.import.form</field>
        <field name="model">stock.picking.import</field>
        <field name="arch" type="xml">
            <form string="Import Returns">
                <group colspan="4" name="help-import">
                    <div colspan="2">
                        <p>Upload below the customer returns document.
                            When you click on the Import button:</p>
                        <ol>
                            <li>If the document has EDIFACT format, you should install the module <em>
                                stock_picking_import_edifact</em>.</li>
                        </ol>
                    </div>
                </group>

                <group name="import">
                    <field name="picking_type_id" />
                    <field name="import_type" />
                    <field
                        name="file"
                        filename="filename"
                        attrs="{'readonly': [('import_type', '=', False)]}"
                    />
                    <field name="filename" invisible="1" />
                </group>
                <group name="common">
                    <field name="doc_type" />
                    <field name="partner_id" attrs="{'invisible': [('import_type','!=','csv')]}" />
                </group>
                <footer>
                    <button
                        name="import_button"
                        type="object"
                        class="oe_highlight"
                        string="Import"
                    />
                    <button special="cancel" string="Cancel" class="oe_link" />
                </footer>
            </form>
        </field>
    </record>
    <record
        id="stock_picking_import_returns_action" model="ir.actions.act_window">
        <field name="name">Import Returns</field>
        <field name="res_model">stock.picking.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="stock_picking_import_returns_menu"
        parent="stock.menu_stock_warehouse_mgmt"
        action="stock_picking_import_returns_action"
        sequence="110"
    />
</odoo>
